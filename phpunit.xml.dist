<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd" backupGlobals="false" bootstrap="vendor/autoload.php" colors="true" processIsolation="false" stopOnFailure="false" defaultTestSuite="package" executionOrder="random" failOnWarning="true" failOnRisky="true" failOnEmptyTestSuite="true" beStrictAboutOutputDuringTests="true" cacheDirectory=".phpunit.cache" backupStaticProperties="false">
  <!--
    I test del package sono divisi fra due `TestCase` incompatibili, che vivono in due `vendor`
    diversi: questa e' la ragione delle due suite.

    `package` e' la suite che gira qui, su Orchestra Testbench, ed e' quella che lancia la CI:
    `vendor/bin/pest` senza argomenti esegue lei, perche' e' la prima dichiarata.

    `shard` raccoglie i test che dichiarano `Tests\TestCase`, cioe' il `TestCase` di un consumer:
    hanno bisogno della sua applicazione vera e si lanciano da li',
    `vendor/bin/pest wm-package/tests/<cartella>`. Qui non possono girare, e senza questa
    separazione facevano morire Pest in caricamento, con un errore che sembrava una suite rotta.

    L'elenco cala man mano che quei test diventano indipendenti: quando sara' vuoto, resta una
    suite sola e queste righe si cancellano.
  -->
  <testsuites>
    <testsuite name="package">
      <directory>tests</directory>
      <exclude>tests/Feature/AddSurnameToUsersMigrationTest.php</exclude>
      <exclude>tests/Feature/AppAuthControllerMeProfileTest.php</exclude>
